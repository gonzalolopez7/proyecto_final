{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "LuckyPennySoftware.MediatR.License": "None"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=[IP_ADDRESS];Port=[PORT];Database=[DB_NAME];Username=[DB_USER];Password=[DB_PASSWORD]"
  },
  "JwtSettings": {
    "SecretKey": "[ENCRYPTION_KEY]",
    "Issuer": "SGCS.API",
    "Audience": "SGCS.Client",
    "ExpirationMinutes": 60
  },
  "AllowedOrigins": [
    "http://[IP_ADDRESS]"
  ],
  "AllowedHosts": "*"
}