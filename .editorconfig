# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# y proyectos .NET
[*.cs]
indent_size = 4

[*.{csproj,sln,props,targets}]
indent_size = 2

# Frontend (JavaScript, JSX, JSON, CSS, HTML)
[*.{js,jsx,ts,tsx,json,css,html}]
indent_size = 2

# Documentación Markdown
[*.md]
trim_trailing_whitespace = false
