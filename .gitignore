# ==============================================================================
# .gitignore — SGCS (Sistema de Gestión Comercial y Stock)
# Stack: .NET 8 (C#) + React / Vite + PostgreSQL + Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# Sistema Operativo
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Variables de Entorno y Secretos
# ------------------------------------------------------------------------------
# Ignorar todos los .env con credenciales reales pero mantener los ejemplos
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.local

# Configuraciones de ASP.NET con credenciales / claves JWT locales
**/appsettings.json
**/appsettings.*.json
!**/appsettings.example.json
!**/appsettings.*.example.json

# ------------------------------------------------------------------------------
# Frontend (Node / Vite / React)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Backend (.NET / C# / Visual Studio / Rider)
# ------------------------------------------------------------------------------
**/bin/
**/obj/
**/publish/

# Archivos de usuario y cache de Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.dbmdl

# JetBrains Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# ------------------------------------------------------------------------------
# Editores de Código (VS Code)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sw?
*~

# ------------------------------------------------------------------------------
# Docker y Bases de Datos locales
# ------------------------------------------------------------------------------
*.db-shm
*.db-wal
postgres_data/
